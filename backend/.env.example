# Copy to backend/.env (ignored by Git) and set your local MySQL credentials.
DB_URL=jdbc:mysql://localhost:3306/fundflow?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# Generate 32 random bytes and Base64-encode them; never reuse the database password.
JWT_SECRET=replace-with-a-random-base64-encoded-32-byte-secret
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
